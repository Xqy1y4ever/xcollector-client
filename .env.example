# Xcollector 入库客户端配置
#
# 复制成 .env 使用（.gitignore 已忽略它）：
#     cp .env.example .env
#
# ⚠️ 这个客户端**不需要** QQ、不需要 NapCat、不需要服务令牌。

# ============================================================
# 1. 后端与身份
# ============================================================
# **后端地址**。也可以在做镜像时用 --build-arg BACKEND_BASE_URL=... 定成默认值
# （见 Dockerfile），但运行时的环境变量优先级更高。
# 容器里跑 compose 时它被 compose 覆盖成 http://backend:8000。
BACKEND_BASE_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT=20
BACKEND_MAX_RETRIES=3

# **必须是某个用户的 UserToken（xc_ 开头）**，不是服务令牌 API_TOKEN。
#
# 为什么：客户端的定位是"每个用户在自己的机器上跑一个"，用 UserToken 时
# 它写的每一条数据都天然属于那个人，越权在实现上不可能发生。用服务令牌
# 也能跑通，但那意味着这个客户端能读写所有人的数据 —— 启动时会有 WARNING。
#
# 怎么拿：在 QQ 里给机器人发 /注册 → 拿验证码 → 到网页上注册 → 得到 UserToken。
CLIENT_TOKEN=

# ============================================================
# 2. 白名单（**只做收窄，不是开关**）
# ============================================================
# 格式和 bot 完全一样（`号码:备注,号码:备注`，备注可省），可以直接把 bot 那份
# 复制过来：  123456789:官方通知群,987654321
#
# ⚠️ **语义与 bot 相反，这一点必须看清楚**：
#
#     bot    ：留空 = 谁都不放行（fail-closed）。它是唯一入库方，空名单意味着
#              "还没配好"，所以关死。
#     client ：留空 = **不额外限制**。客户端的过滤条件是**你在后端配的订阅**，
#              白名单只是在这个基础上再收窄一层（源库里往往有几百个群，
#              先按群/发送者砍一刀能省很多无用扫描）。
#
#   照抄 bot 的 fail-closed 会让一个已经跑通的客户端在升级后**静默停止入库**，
#   所以这里刻意选了"默认不改变行为"。
#
# 两个是「同时满足」（AND）：群在群名单里 **且** 发送者在发送者名单里。
# 号码形状不对（比如打成 `abc`）会**拒绝启动**并指出是哪一项 ——
# 写错一个字符的后果是"那个来源永远不进清单"，属于最难发现的故障，所以宁可起不来。
#
# 改了这里的号码之后，之前**因为白名单被跳过**的消息会自动放回来重看一次
# （靠镜像库里的白名单指纹），不需要手动清任何东西。
CLIENT_GROUP_WHITELIST=
CLIENT_SENDER_WHITELIST=

# ============================================================
# 3. 源库（聊天记录数据库）
# ============================================================
# 指向 nt_msg_db_util 的 **3.export.py** 产出的 nt_msg_export.db（明文 SQLite）。
#
# ⚠️ 不是 nt_msg.db（那是加密的原始库），也不是 nt_msg_plain.db
#    （那里面 40800 列还是 Protobuf，没有 text/content 这些能直接用的列）。
#
#   NTQQ(nt_msg.db) ──1.decrypt.py──▶ nt_msg_plain.db ──3.export.py──▶ nt_msg_export.db
CLIENT_DB_PATH=

# 一轮最多从库里取多少条新消息
CLIENT_BATCH_SIZE=200
# 首次运行（还没有游标）时往回看多少小时。太短会漏，太长会把早就过期的
# 旧通知一起灌进清单。
CLIENT_INITIAL_LOOKBACK_HOURS=72
# 一轮最多处理多少条（防止第一次跑就一口气吃掉几万条）
CLIENT_MAX_MESSAGES_PER_CYCLE=500

# ---- 附件 ----
# 源库里的附件通常只有 CDN 地址和 md5，而 QQ 的 CDN 链接几小时就过期。
# 把 NTQQ 的附件目录（或你自己导出的附件目录）配在这里，客户端就能按
# md5 / 文件名找回真实字节并上传给后端。
CLIENT_ATTACHMENT_ROOT=
# 找不到本地字节时：url = 只留 CDN 地址（可能是死链，前端可能打不开）
#                   skip = 干脆不记这个附件
CLIENT_MISSING_ATTACHMENT=url

# ============================================================
# 4. 抽取
# ============================================================
# rule = 只用规则（**完全不发模型请求**，适合先跑通）
# llm  = 只信模型（失败则降级到规则并记成"盲区"）
# both = 模型为主、规则兜底（推荐）
CLIENT_EXTRACTOR=rule

# 任何 OpenAI 兼容端点（DeepSeek / 通义 / OpenAI / 自建 vLLM、Ollama 都是这个形状）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT=60
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2

# 交叉验证：用第二个模型再抽一次，两个模型对截止时间不一致就把这条标成
# conflict（前端会标红）。这是"LLM 可出错但不可静默出错"里最贵也最有效的一环。
CLIENT_CROSS_CHECK_ENABLED=false
LLM_SECONDARY_API_BASE=
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_MODEL=

# 把附件字节也喂给模型（需要模型支持看图）。默认关：源库里通常只有 URL。
CLIENT_VLM_ENABLED=false

# ============================================================
# 5. 运行
# ============================================================
# 常驻模式下的轮询间隔（秒）。用 --once + 计划任务时这个值不起作用。
CLIENT_POLL_SECONDS=300

# 游标不再存在后端：客户端**自己**维护一份镜像库（下面配置）。
# 留空 = 放在源库旁边（`<源库>.mirror.db`）。
CLIENT_MIRROR_PATH=
# 增量扫描时往回多看的时长（小时）。回看窗口同时覆盖两种"旧消息也要重看"的情况：
# 同一秒里后到的、以及**内容被编辑过**的。窗口越大越不容易漏，代价是每轮多读一点。
CLIENT_RECHECK_OVERLAP_HOURS=2

# ---- 补充：新消息在改一条已读消息 ----
# 例：有人回复「下周三前交材料」那条通知，说「改到本周五」。
# 打开它 → **更新原来那条任务**（靠后端 (user_id, raw_message_id) 幂等），不是新建一条。
CLIENT_AMENDMENT_ENABLED=true
# 只认最近这么多小时内的引用：三个月前那条通知的回复，几乎一定是另一件事。
CLIENT_AMENDMENT_MAX_AGE_HOURS=72
# 回复/引用里"被引用对象"可能装在这些键上（逗号分隔）。默认值来自
# nt_msg_db_util 的群字段文档（47402 与群内序号匹配）。留空 = 用默认那组。
CLIENT_QUOTE_KEYS=

# 群静默多久算缺口（小时）。和 bot 的 GAP_ALERT_HOURS 同一套判据。
CLIENT_GAP_ALERT_HOURS=2

# 全系统统一时区。**必须和 bot / 后端用同一个值**，否则"下周三前"会在两条
# 链路上解析到不同的时刻。
DIGEST_TZ=Asia/Shanghai

CLIENT_LOG_LEVEL=INFO
CLIENT_LOG_PREVIEW_CHARS=60
