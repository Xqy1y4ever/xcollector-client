# ============================================================
# xcollector-client 配置
#
# **只有十几个键**。其余参数（批量大小、解密参数、重试次数、LLM 温度…）
# 都写死在 `app/config.py` 里了 —— 那些值要么从来没被改对过，要么改错之后的
# 现象极难查（例如改 kdf_iter，症状是"解出来的库全是乱码"）。想改就改代码。
#
# 复制成 .env 再改：
#     cp .env.example .env        # Windows: copy .env.example .env
# .env 已经被 .gitignore 忽略（里面有令牌和密钥，**绝不要提交**）。
# ============================================================

# ============================================================
# 1. 后端
# ============================================================
BACKEND_BASE_URL=http://127.0.0.1:8000

# 某个用户的 **UserToken**（xc_ 开头），不是服务令牌 API_TOKEN。
# 在网页上注册后可以在「我的」里看到（或问 bot 要）。
# ⚠️ 用服务令牌也能跑，但那意味着这个客户端能读写**所有人**的数据 ——
#    启动自检会警告这件事。
CLIENT_TOKEN=

# ============================================================
# 2. 输入：二选一
# ============================================================
# A 方案（推荐）：QQ 的**加密**原始库 nt_msg.db。给了它，客户端自己完成
#    「剥头 → 解密 → 导出」，你只需要再给一个密钥。
#    导出库固定放在 nt_msg.db 旁边（nt_msg_export.db）。
CLIENT_NT_MSG_DB=

# 密钥：16 个 ASCII 字符，从 NTQQ 进程内存里自己取（见 README）。
# 取法：QQBackup/qq-win-db-key，或本机 nt_msg_db_util/getkey.ps1。
# **换账号/换机器/重装 QQ 都会变。**
CLIENT_NT_MSG_KEY=
# 或者从文件读（**更稳妥**：环境变量会出现在 ps / 容器 inspect / CI 日志里）。
# 文件内容首尾空白会被自动去掉。
CLIENT_NT_MSG_KEY_FILE=

# B 方案：现成的结构化导出库（nt_msg_db_util 的 3.export.py 产物）。
# 两个都配了就以它为准。
CLIENT_DB_PATH=

# ============================================================
# 3. 状态库（客户端自己的"已读到哪"）
# ============================================================
# 记「这条源消息处理过没有」—— 增量判据就是它：不在里面 = 没读过，一定要读。
# 留空 = 放在源库旁边（<源库>.mirror.db）。
# ⚠️ **别随便删**：删了会把整个源库重新读一遍（订阅外的消息很便宜，
#    但真通知会重新抽一次、花模型的钱；后端幂等会挡住重复入库）。
#    真的想重来，改个路径更安全。
CLIENT_MIRROR_PATH=

# ============================================================
# 4. 白名单（**只做收窄，不是开关**）
# ============================================================
# 格式和 bot 一样（`号码:备注,号码:备注`，备注可省，全角逗号/冒号也认）。
#
# ⚠️ 语义与 bot **相反**：
#     bot    ：留空 = 谁都不放行（fail-closed，它是实时入库方）
#     client ：留空 = **全都读**（客户端读的是你自己账号的聊天记录库）
# 两个是「同时满足」（AND）。号码形状不对会**拒绝启动**并指出是哪一项。
#
# 源库里往往有几百个群、几十万条消息。想少扫一点，就在这里按群/发送者砍一刀。
CLIENT_GROUP_WHITELIST=
CLIENT_SENDER_WHITELIST=

# ============================================================
# 5. 附件
# ============================================================
# 附件字节的搜索根目录（可选）。导出库里通常只有 CDN URL 和 md5，而 QQ 的 CDN
# 链接几小时就过期。把 NTQQ 的附件目录配在这里，客户端就能按 md5/文件名找回
# 真实字节并上传给后端。找不到时只留远程地址（并在日志里说明那可能是死链）。
CLIENT_ATTACHMENT_ROOT=

# ============================================================
# 6. 抽取
# ============================================================
# rule = 只用规则（**完全不发模型请求**，适合先跑通、先看效果）
# llm  = 只信模型（失败则降级到规则，并记成"盲区"进统计）
# both = 模型为主、规则兜底（推荐）
CLIENT_EXTRACTOR=rule

# 用 llm / both 时才需要（默认是 DeepSeek 的地址与模型名）。
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ============================================================
# 7. 运行
# ============================================================
# 常驻模式（--loop）的轮询间隔（秒）。用 --once + 计划任务时不起作用。
CLIENT_POLL_SECONDS=300

# DEBUG / INFO / WARNING
CLIENT_LOG_LEVEL=INFO

# 全系统统一时区。**必须和 bot / 后端用同一个值** —— 否则同一条"下周三前"
# 在两条链路上会解析到不同的时刻，而用户没法知道该信哪个。
DIGEST_TZ=Asia/Shanghai
