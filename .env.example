# Xcollector 入库客户端配置
#
# 复制成 .env 使用（.gitignore 已忽略它）：
#     cp .env.example .env
#
# ⚠️ 这个客户端**不需要** QQ、不需要 NapCat、不需要服务令牌。

# ============================================================
# 1. 后端与身份
# ============================================================
# **后端地址**。也可以在做镜像时用 --build-arg BACKEND_BASE_URL=... 定成默认值
# （见 Dockerfile），但运行时的环境变量优先级更高。
# 容器里跑 compose 时它被 compose 覆盖成 http://backend:8000。
BACKEND_BASE_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT=20
BACKEND_MAX_RETRIES=3

# **必须是某个用户的 UserToken（xc_ 开头）**，不是服务令牌 API_TOKEN。
#
# 为什么：客户端的定位是"每个用户在自己的机器上跑一个"，用 UserToken 时
# 它写的每一条数据都天然属于那个人，越权在实现上不可能发生。用服务令牌
# 也能跑通，但那意味着这个客户端能读写所有人的数据 —— 启动时会有 WARNING。
#
# 怎么拿：在 QQ 里给机器人发 /注册 → 拿验证码 → 到网页上注册 → 得到 UserToken。
CLIENT_TOKEN=

# ============================================================
# 2. 白名单（**只做收窄，不是开关**）
# ============================================================
# 格式和 bot 完全一样（`号码:备注,号码:备注`，备注可省），可以直接把 bot 那份
# 复制过来：  123456789:官方通知群,987654321
#
# ⚠️ **语义与 bot 相反，这一点必须看清楚**：
#
#     bot    ：留空 = 谁都不放行（fail-closed）。它是唯一入库方，空名单意味着
#              "还没配好"，所以关死。
#     client ：留空 = **不额外限制**。客户端的过滤条件是**你在后端配的订阅**，
#              白名单只是在这个基础上再收窄一层（源库里往往有几百个群，
#              先按群/发送者砍一刀能省很多无用扫描）。
#
#   照抄 bot 的 fail-closed 会让一个已经跑通的客户端在升级后**静默停止入库**，
#   所以这里刻意选了"默认不改变行为"。
#
# 两个是「同时满足」（AND）：群在群名单里 **且** 发送者在发送者名单里。
# 号码形状不对（比如打成 `abc`）会**拒绝启动**并指出是哪一项 ——
# 写错一个字符的后果是"那个来源永远不进清单"，属于最难发现的故障，所以宁可起不来。
#
# 改了这里的号码之后，之前**因为白名单被跳过**的消息会自动放回来重看一次
# （靠镜像库里的白名单指纹），不需要手动清任何东西。
CLIENT_GROUP_WHITELIST=
CLIENT_SENDER_WHITELIST=

# ============================================================
# 3. nt_msg.db：剥头 + 解密 + 导出（可选，但**推荐**）
# ============================================================
# 配了 CLIENT_NT_MSG_DB 之后，你只需要给**一个输入**（QQ 的原始加密库），
# 客户端自己完成上游 nt_msg_db_util 的两步：
#
#   nt_msg.db ─剥头→ nt_msg_clear.db ─解密→ nt_msg_plain.db ─导出→ nt_msg_export.db
#   （SQLCipher 加密，  （砍掉前面 1024   （普通 SQLite，        （字段有名字、
#     前面还有 1024      字节的 QQ 头）     还是 QQ 的数字列名）    正文是文本）
#     字节的 QQ 头）
#
# 这两步就是 nt_msg_db_util 的 1.decrypt.py 与 3.export.py（已整合进本项目，
# 见 app/ntmsg_db/ 和 msgdb/VENDORED.md）。不想用就把这一节整段留空，
# 客户端会像以前一样直接读 CLIENT_DB_PATH。
#
# 依赖：sqlcipher3 + protobuf（requirements.txt 里按平台装好了）。

# 加密的 nt_msg.db 路径。在 QQ 的数据目录里，形如：
#   .../nt_qq/nt_db/nt_msg.db
CLIENT_NT_MSG_DB=

# 密钥（**16 个 ASCII 字符**）。自己从 NTQQ 进程内存里取，取法见 README
# 「怎么拿到密钥」一节。换 QQ 账号 / 换机器都要重取。
#
# ⚠️ 不要提交进 git、不要贴进聊天记录。用 CLIENT_NT_MSG_KEY_FILE 更稳妥。
CLIENT_NT_MSG_KEY=
# 或者把密钥写进一个文件（内容首尾的空白/换行会被自动去掉）：
CLIENT_NT_MSG_KEY_FILE=

# 中间产物放哪。留空 = 放在 nt_msg.db 旁边（与上游 1.decrypt.py 的默认命名一致）。
CLIENT_NT_MSG_CLEAR_PATH=
CLIENT_NT_MSG_PLAIN_PATH=

# nt_msg.db 前面那段 QQ 自定义头的长度（固定 1024）。
CLIENT_NT_MSG_HEADER_SIZE=1024

# 下面这几个是上游 1.decrypt.py 用的 PRAGMA 值，**不要随便改**
# （改了就等于换了一套加密参数，只有你自己造过库才需要）。
# 注意上游的顺序：cipher_page_size 必须在 key 之前 —— 客户端照抄了这个顺序。
CLIENT_NT_MSG_PAGE_SIZE=4096
CLIENT_NT_MSG_KDF_ITER=4000
CLIENT_NT_MSG_KDF_ALGORITHM=sha512
CLIENT_NT_MSG_HMAC_ALGORITHM=sha1

# 解密这一步跑不跑（关掉 = 明文库/导出库你自己维护）。
CLIENT_DECRYPT_ENABLED=true
# 每批从加密库读多少行（遇坏页会自动缩小，成功后再放大回来）。
CLIENT_DECRYPT_BATCH_SIZE=5000
# 只解密哪些表，逗号分隔。留空 = 全部（和上游一样）。
# 只关心消息的话可以写 group_msg_table,c2c_msg_table 省一点时间。
CLIENT_DECRYPT_TABLES=
# 解完让 SQLite 自己查一遍明文库：quick（默认，快）/ full（连索引一起查）/ off。
# 这只影响报告；查不过会打 ERROR 日志。
CLIENT_DECRYPT_INTEGRITY=quick
# 允许多少行因为坏页被跳过。-1 = 不限（上游行为）。
#
# QQ 的库确实会有坏页（上游为此专门写了"重连 + 缩小批次 + 跳过坏 rowid"）。
# 默认容忍是为了不因为一个坏页卡死整天，但**每一次跳过都会打 ERROR 级日志并记进
# 报告** —— 被跳过的行意味着那几条消息永远进不来，这必须让人看见。
CLIENT_DECRYPT_MAX_SKIPS=-1

# 导出这一步跑不跑。
CLIENT_EXPORT_ENABLED=true
# 要不要连私聊消息一起导。默认 true = 和上游 3.export.py 一样两张表都导。
CLIENT_EXPORT_INCLUDE_C2C=true
CLIENT_EXPORT_BATCH=2000
# 给 group_messages 补 "40003"/"40850" 两列（群内序号、被回复消息的序号）。
# 上游的导出表没有它们，"这条消息在补充哪条通知"就没法确定性反查。
CLIENT_EXPORT_ADD_SEQ=true
# 增量导出：只把水位线之后的源行写进导出库。**默认关（每次全量）**。
#
# 按时间过滤会让"时间戳没变、内容变了"的旧消息永远不进导出库 —— 于是一层一层
# 往上看，客户端那边也永远发现不了它被编辑过。全量的代价是每轮重新解析一遍源库
# （实测 77 万行约 45 秒）。打开它能省时间，但要接受上面那条代价。
CLIENT_EXPORT_INCREMENTAL=false
# 只在上面的增量模式生效时用：往回多看多少秒（导出是幂等的，多看只会慢一点）。
CLIENT_EXPORT_OVERLAP_SECONDS=3600
# ============================================================
# 4. 源库（聊天记录数据库）
# ============================================================
# **两种用法二选一**：
#
#   A. 配了 CLIENT_NT_MSG_DB  → 这一项可以留空，导出库默认放在 nt_msg.db 旁边
#      （nt_msg_export.db）。想让导出库放到别处就填这里。
#   B. 没配 CLIENT_NT_MSG_DB  → 这一项**必须**填，指向现成的导出库：
#         · 上游 nt_msg_db_util 的 3.export.py 产出的 nt_msg_export.db，或
#         · 本客户端上一次导出的库
#
# ⚠️ 不是 nt_msg.db（加密的原始库），也不是 nt_msg_plain.db（那里面 40800 列
#    还是 Protobuf，没有 text/content 这些能直接用的列）。
CLIENT_DB_PATH=

# 一轮最多从库里取多少条新消息
CLIENT_BATCH_SIZE=200
# 一轮最多处理多少条（防止第一次运行就一口气吃掉几十万条）。
#
# ⚠️ **读什么由"读没读过"决定，不由时间决定。** 源库里凡是镜像里没标记过的都要读，
#    不管它多老 —— 时间窗口会让"比窗口更老、而镜像里又没有"的消息（换过导出库、
#    镜像被删过、白名单刚放开）永远读不到，而那正是"静默漏掉通知"。
#    这个值只决定**一轮读多少**，不决定读哪些。
#
#    第一轮会把导出库里所有群消息过一遍（订阅外的记成 skipped，很便宜），
#    之后每轮只读新增的。想少读一点，用下面的白名单收窄。
CLIENT_MAX_MESSAGES_PER_CYCLE=500

# ---- 附件 ----
# 源库里的附件通常只有 CDN 地址和 md5，而 QQ 的 CDN 链接几小时就过期。
# 把 NTQQ 的附件目录（或你自己导出的附件目录）配在这里，客户端就能按
# md5 / 文件名找回真实字节并上传给后端。
CLIENT_ATTACHMENT_ROOT=
# 找不到本地字节时：url = 只留 CDN 地址（可能是死链，前端可能打不开）
#                   skip = 干脆不记这个附件
CLIENT_MISSING_ATTACHMENT=url

# ============================================================
# 5. 抽取
# ============================================================
# rule = 只用规则（**完全不发模型请求**，适合先跑通）
# llm  = 只信模型（失败则降级到规则并记成"盲区"）
# both = 模型为主、规则兜底（推荐）
CLIENT_EXTRACTOR=rule

# 任何 OpenAI 兼容端点（DeepSeek / 通义 / OpenAI / 自建 vLLM、Ollama 都是这个形状）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT=60
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2

# 交叉验证：用第二个模型再抽一次，两个模型对截止时间不一致就把这条标成
# conflict（前端会标红）。这是"LLM 可出错但不可静默出错"里最贵也最有效的一环。
CLIENT_CROSS_CHECK_ENABLED=false
LLM_SECONDARY_API_BASE=
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_MODEL=

# 把附件字节也喂给模型（需要模型支持看图）。默认关：源库里通常只有 URL。
CLIENT_VLM_ENABLED=false

# ============================================================
# 6. 运行
# ============================================================
# 常驻模式下的轮询间隔（秒）。用 --once + 计划任务时这个值不起作用。
CLIENT_POLL_SECONDS=300

# 游标不再存在后端：客户端**自己**维护一份镜像库（下面配置）。
# 留空 = 放在源库旁边（`<源库>.mirror.db`）。
#
# 这个库里的"已读标记"就是**唯一**的增量判据：不在里面 = 没读过，一定要读。
CLIENT_MIRROR_PATH=
# **回看窗口**（小时）：镜像里**已读**的消息，最近这段时间内的要重看一遍，用来发现
# "内容被编辑过"（重看时比对内容指纹，变了就重抽）。它不决定"哪些没读过"。
#
# 调大 = 更容易发现很久以前的改动，代价是每轮多读一点。真要全量重看，用 --since-hours。
CLIENT_RECHECK_OVERLAP_HOURS=2

# ---- 补充：新消息在改一条已读消息 ----
# 例：有人回复「下周三前交材料」那条通知，说「改到本周五」。
# 打开它 → **更新原来那条任务**（靠后端 (user_id, raw_message_id) 幂等），不是新建一条。
CLIENT_AMENDMENT_ENABLED=true
# 只认最近这么多小时内的引用：三个月前那条通知的回复，几乎一定是另一件事。
CLIENT_AMENDMENT_MAX_AGE_HOURS=72
# 回复/引用里"被引用对象"可能装在这些键上（逗号分隔）。默认值来自
# nt_msg_db_util 的群字段文档（47402 与群内序号匹配）。留空 = 用默认那组。
CLIENT_QUOTE_KEYS=

# 群静默多久算缺口（小时）。和 bot 的 GAP_ALERT_HOURS 同一套判据。
CLIENT_GAP_ALERT_HOURS=2

# 全系统统一时区。**必须和 bot / 后端用同一个值**，否则"下周三前"会在两条
# 链路上解析到不同的时刻。
DIGEST_TZ=Asia/Shanghai

CLIENT_LOG_LEVEL=INFO
CLIENT_LOG_PREVIEW_CHARS=60
